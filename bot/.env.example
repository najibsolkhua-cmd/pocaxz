# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=
# Ключ Claude API (необязательно). Без него бот отвечает разделами базы знаний.
ANTHROPIC_API_KEY=
# Порт HTTP API для расширения (за ним — HTTPS-прокси, например Caddy или nginx)
PORT=8787
# Ссылка «Установить» в меню бота и ссылка на живую поддержку
# Отчёт по баннерам: https://<сервер>/stats?key=STATS_KEY и команда /stats для этих чатов
STATS_KEY=
ADMIN_CHAT_IDS=
INSTALL_URL=https://solkhua.ru
HUMAN_SUPPORT=https://t.me/max_max3700
