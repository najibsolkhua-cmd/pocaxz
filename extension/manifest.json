{
  "manifest_version": 3,
  "name": "solk / job",
  "version": "0.3.1",
  "description": "Мини-CRM для поиска работы: собирает вакансии с hh.ru, Avito, Telegram и сайтов компаний прямо в вашем браузере и показывает подходящие.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "scripting",
    "notifications",
    "idle",
    "activeTab"
  ],
  "host_permissions": [
    "https://hh.ru/*",
    "https://*.hh.ru/*",
    "https://avito.ru/*",
    "https://www.avito.ru/*",
    "https://m.avito.ru/*",
    "https://t.me/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "solk / job",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}